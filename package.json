{
  "name": "alethinosplan",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "check": "tsc -b --pretty false",
    "test": "vitest run && node --test scripts/check-deploy-env.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:deploy-env": "node scripts/check-deploy-env.mjs",
    "build:pages": "npm run check:deploy-env && node scripts/clean-dist.mjs && npm run build",
    "preview:pages": "npm run build:pages && wrangler pages dev dist --ip 127.0.0.1 --port 8789",
    "deploy:pages": "npm run build:pages && wrangler pages deploy dist",
    "test:pages": "playwright test --config playwright.pages.config.ts",
    "docs:capture": "node scripts/capture-demo.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "lucide-react": "1.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "wrangler": "4.151.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
